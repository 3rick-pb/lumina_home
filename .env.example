# ==============================================================================
# LUMINA HOME - CONFIGURACIÓN DE ENTORNO Y PASARELA PAYPHONE (ECUADOR)
# ==============================================================================

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon
SUPABASE_SERVICE_ROLE_KEY=tu_clave_privada_service_role

# URL Base de la Aplicación (Para redirecciones de checkout y callbacks)
# En desarrollo: http://localhost:3000
# En producción (Vercel): https://tutienda.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# PASARELA DE PAGOS: PAYPHONE ECUADOR
# Portal de Desarrollador: https://developer.payphonetodoesposible.com
# ==============================================================================

# Token de Comercio (Bearer Token secreto generado con tu RUC en PayPhone Developer)
# ¡NUNCA USAR NEXT_PUBLIC_! Esta clave es estrictamente privada en el servidor.
PAYPHONE_TOKEN=tu_token_de_comercio_payphone

# ID de Aplicación de PayPhone
NEXT_PUBLIC_PAYPHONE_APP_ID=tu_app_id_payphone
PAYPHONE_APP_ID=tu_app_id_payphone

# Entorno: 'sandbox' para pruebas, 'production' para cobros reales
NEXT_PUBLIC_PAYPHONE_ENV=sandbox
PAYPHONE_ENV=sandbox

# URL de la API de PayPhone (Predeterminado: https://pay.payphonetodoesposible.com/api)
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api

# ==============================================================================
# CORREOS TRANSACCIONALES (SMTP / FACTURACIÓN / DESPACHOS)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=Lumina Home <tu_correo@gmail.com>
SMTP_SECURE=false
